generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  COLLECTOR
  CLIENT
}

model User {
  id                 String        @id @default(uuid())
  name               String?
  email              String?       @unique
  password           String
  role               Role          @default(CLIENT)
  phoneNumber        String        @unique
  createdAt          DateTime      @default(now())
  // Relation avec les réservations en tant que client
  clientReservations Reservation[] @relation(name: "ClientReservations")

  // Relation avec les réservations en tant que collecteur
  collectorReservations Reservation[] @relation(name: "CollectorReservations")
}

model Service {
  id           String        @id @default(uuid())
  name         String
  description  String?
  image        String
  like         Int           @default(0)
  price        Float
  unit         String
  createdAt    DateTime      @default(now())
  reservations Reservation[]
}

model Reservation {
  id String @id @default(uuid())

  // Lié au client
  client   User   @relation(name: "ClientReservations", fields: [clientId], references: [id])
  clientId String

  // Lié au collecteur
  collector   User?   @relation(name: "CollectorReservations", fields: [collectorId], references: [id])
  collectorId String?

  // Lié au service choisi
  service   Service @relation(fields: [serviceId], references: [id])
  serviceId String

  // Statuts
  status         ReservationStatus @default(PENDING)
  deliveryStatus DeliveryStatus    @default(NOT_STARTED)
  processingTime ProcessingTime    @default(NORMAL_24H)

  createdAt DateTime @default(now())

  // 📍 Adresse de collecte
  pickupAddress     String?
  isCurrentLocation Boolean @default(false)
  latitude          Float?
  longitude         Float?

  // 📞 Contact du client
  whatsappNumber String?

  // 🗓 Date et heure de collecte
  pickupDate DateTime
  pickupTime String

  // 📝 Remarque du client
  additionalNotes String?
}

enum ReservationStatus {
  PENDING // En attente de traitement
  CONFIRMED // Acceptée par un collecteur/admin
  COMPLETED // Réalisation confirmée
  CANCELED // Annulée
}

enum DeliveryStatus {
  NOT_STARTED // Pas encore en livraison
  IN_PROGRESS // En cours de livraison
  DELIVERED // Livraison terminée
}

enum ProcessingTime {
  EXPRESS_4H
  EXPRESS_8H
  NORMAL_24H
}
